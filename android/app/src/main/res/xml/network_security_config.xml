<?xml version="1.0" encoding="utf-8"?>
<!--
  Nenhum tráfego em texto claro. O app funciona 100% offline; o WebView carrega
  os arquivos locais por https://localhost.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
